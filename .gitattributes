# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.cs text diff=csharp
*.csproj text
*.sln text
*.slnx text
*.md text
*.json text
*.yaml text
*.yml text
*.js text eol=lf
*.css text
*.html text
*.sh text eol=lf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary

# Archives
*.zip binary
*.nupkg binary

# Config
*.editorconfig text
.gitattributes text
.gitignore text
